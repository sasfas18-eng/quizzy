# --- required for real question generation (without it, generation is disabled, never faked)
ANTHROPIC_API_KEY=
QUIZZY_MODEL=claude-sonnet-5-5
# optional: a different model for the blind-solver verifier
QUIZZY_VERIFIER_MODEL=
# --- ops
QUIZZY_DATA_DIR=./data
QUIZZY_ADMIN_EMAILS=you@example.com
QUIZZY_COOKIE_SECURE=1          # set when served over HTTPS
QUIZZY_PUBLIC_URL=https://quizzy.example.com
QUIZZY_MAX_UPLOAD_MB=40
# --- password reset email (without SMTP_HOST the reset feature reports "unavailable")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Quizzy <no-reply@example.com>
# --- NEVER in production
# QUIZZY_ALLOW_FAKE_LLM=1       # test generator; output is stamped "test-generator"
# QUIZZY_DEV_LOG_RESET_LINKS=1
