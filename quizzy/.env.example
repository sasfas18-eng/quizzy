# --- required for real question generation (without it, generation is disabled, never faked)
ANTHROPIC_API_KEY=
QUIZZY_MODEL=claude-sonnet-5-5
# optional: a different model for the blind-solver verifier
QUIZZY_VERIFIER_MODEL=
# --- OR a free/other provider (any OpenAI-compatible endpoint). Used only when ANTHROPIC_API_KEY is empty.
# Groq:       QUIZZY_LLM_BASE_URL=https://api.groq.com/openai/v1   QUIZZY_LLM_MODEL=<model from your Groq dashboard>
# OpenRouter: QUIZZY_LLM_BASE_URL=https://openrouter.ai/api/v1     QUIZZY_LLM_MODEL=<a ':free' model>
# Ollama:     QUIZZY_LLM_BASE_URL=http://localhost:11434/v1        QUIZZY_LLM_MODEL=<pulled model>   (no key; limited only by your hardware)
QUIZZY_LLM_BASE_URL=
QUIZZY_LLM_API_KEY=
QUIZZY_LLM_MODEL=
# BEST FOR "NO LIMIT": a pool. Requests rotate across endpoints, each is paced under its own rpm, a 429 sends the
# request to the next one, and if all are exhausted the call waits (up to QUIZZY_LLM_MAX_WAIT seconds) instead of failing.
# QUIZZY_LLM_POOL=[{"name":"groq","base_url":"https://api.groq.com/openai/v1","api_key":"gsk_...","model":"<model>","rpm":25},{"name":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key":"sk-or-...","model":"<free model>","rpm":15},{"name":"ollama","base_url":"http://ollama:11434/v1","model":"qwen2.5:7b","rpm":600}]
# QUIZZY_LLM_MAX_WAIT=900
# QUIZZY_LLM_RPM=20             # default rpm per endpoint
# --- ops
QUIZZY_DATA_DIR=./data
QUIZZY_ADMIN_EMAILS=you@example.com
QUIZZY_COOKIE_SECURE=1          # set when served over HTTPS
QUIZZY_PUBLIC_URL=https://quizzy.example.com
QUIZZY_MAX_UPLOAD_MB=40
# --- password reset email (without SMTP_HOST the reset feature reports "unavailable")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Quizzy <no-reply@example.com>
# --- NEVER in production
# QUIZZY_ALLOW_FAKE_LLM=1       # test generator; output is stamped "test-generator"
# QUIZZY_DEV_LOG_RESET_LINKS=1
